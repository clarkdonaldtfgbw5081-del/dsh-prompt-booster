{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "jsx": "react-jsx",
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node"]
  },
  "include": ["src", "demo", "tests"],
  "exclude": ["node_modules", ".reference", "lib"]
}
